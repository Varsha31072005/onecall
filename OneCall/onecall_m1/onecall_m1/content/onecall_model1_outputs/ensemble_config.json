{
  "model_type": "pytorch_bilstm",
  "weights": {
    "text_model": 0.7,
    "xgboost": 0.3
  },
  "imputation": {
    "train_median_age": 42.0,
    "train_median_duration": 21.0
  },
  "labels": {
    "id2label": {
      "0": "low",
      "1": "medium",
      "2": "high"
    },
    "label2id": {
      "low": 0,
      "medium": 1,
      "high": 2
    }
  },
  "features": {
    "numeric_cols": [
      "age_imputed",
      "age_is_missing",
      "duration_days_imputed",
      "duration_is_missing",
      "symptom_count",
      "comorbidity_count",
      "has_comorbidity",
      "text_length"
    ],
    "categorical_cols": [
      "gender_clean",
      "duration_unit"
    ],
    "feature_names": [
      "age_imputed",
      "age_is_missing",
      "duration_days_imputed",
      "duration_is_missing",
      "symptom_count",
      "comorbidity_count",
      "has_comorbidity",
      "text_length",
      "gender_clean_female",
      "gender_clean_male",
      "duration_unit_days",
      "duration_unit_hours",
      "duration_unit_minutes",
      "duration_unit_months",
      "duration_unit_weeks"
    ]
  }
}